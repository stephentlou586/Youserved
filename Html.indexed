<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ServedYouAre - You are the business</title>
<style>
*{box-sizing:border-box;font-family:Inter,Arial,sans-serif}body{margin:0;background:#fafaf7;color:#111}
header{padding:14px 20px;display:flex;justify-content:space-between;align-items:center;background:#fff;border-bottom:1px solid #eee;position:sticky;top:0;z-index:10}
.logo{font-weight:900;font-size:22px}.logo span{color:#f59e0b}
.btn{background:#111;color:#fff;border:0;padding:10px 18px;border-radius:999px;font-weight:700;cursor:pointer}
.btn.light{background:#fff;color:#111;border:1px solid #111}.btn.full{width:100%;margin-top:10px}
.btn.green{background:#16a34a}.btn.red{background:#dc2626}.btn.orange{background:#f59e0b;color:#111}
.tabs{max-width:1200px;margin:16px auto;padding:0 20px;display:flex;gap:10px;flex-wrap:wrap}
.tab{padding:10px 18px;border-radius:999px;border:1px solid #ddd;background:#fff;cursor:pointer;font-weight:700}
.tab.active{background:#111;color:#fff}
.hero{padding:30px 20px;display:grid;grid-template-columns:1.2fr 0.8fr;gap:20px;max-width:1200px;margin:auto}
.hero h1{font-size:44px;line-height:0.9;margin:10px 0;letter-spacing:-1.5px}
.tag{background:#fff3c4;padding:5px 10px;border-radius:999px;font-size:11px;font-weight:800}
.card{background:#fff;border:1px solid #eee;border-radius:18px;padding:18px}
.filters{max-width:1200px;margin:10px auto;padding:0 20px;display:flex;gap:8px;flex-wrap:wrap}
.filters input,.filters select{padding:11px;border-radius:12px;border:1px solid #ddd;min-width:180px}
.feed{max-width:1200px;margin:auto;padding:20px;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}
.post{background:#fff;border:1px solid #eee;border-radius:16px;padding:14px}
.head{display:flex;gap:10px;align-items:center}
.avatar{width:44px;height:44px;border-radius:50%;background:#f59e0b;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800}
.actions{display:flex;gap:6px;margin-top:10px;flex-wrap:wrap}
.sbtn{padding:6px 12px;border-radius:999px;border:1px solid #ddd;background:#fff;font-size:12px;font-weight:700;cursor:pointer;text-decoration:none;color:#111}
.sbtn.primary{background:#111;color:#fff}
.sbtn.social{padding:5px 9px;font-size:14px}
.comment{background:#f5f5f0;padding:7px 10px;border-radius:10px;margin-top:6px;font-size:13px}
.dash{max-width:1200px;margin:auto;padding:20px;display:grid;grid-template-columns:1fr 1fr;gap:16px}
input,textarea,select{width:100%;padding:11px;border-radius:10px;border:1px solid #ddd;margin-top:6px}
footer{padding:30px;text-align:center;color:#999;font-size:12px}
@media(max-width:900px){.hero{grid-template-columns:1fr}.dash{grid-template-columns:1fr}.hero h1{font-size:34px}}
.hidden{display:none}
.badge{padding:3px 8px;border-radius:999px;font-size:10px;font-weight:800}
.badge.pending{background:#fef3c7;color:#92400e}.badge.approved{background:#dcfce7;color:#166534}.badge.rejected{background:#fee2e2;color:#991b1b}.badge.expired{background:#111;color:#fff}
.adminRow{display:flex;justify-content:space-between;align-items:center;background:#fff8db;border:1px solid #fde68a;padding:10px;border-radius:12px;margin-bottom:8px;gap:10px}
.reminderBanner{background:#fff3c4;border:1px solid #fde68a;padding:12px;border-radius:12px;margin-bottom:12px;font-size:13px;font-weight:600}
.socialRow{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:6px}
</style></head><body>
<header><div class="logo">SERVED<span>YOUARE</span></div><div><span id="userLabel" style="font-size:12px;color:#666"></span> <button class="btn light" onclick="logout()">Logout</button></div></header>
<div class="tabs"><button class="tab active" id="tabMarket" onclick="showTab('market')">Marketplace</button><button class="tab" id="tabDash" onclick="showTab('dash')">My Dashboard</button><button class="tab hidden" id="tabAdmin" onclick="showTab('admin')">Admin + Reminders</button></div>

<div id="marketView">
<section class="hero"><div><span class="tag">BUSINESS EXCHANGE + SOCIAL MEDIA HUB</span><h1>You are the business.<br>Advertise who you are.</h1><p>Only approved profiles show. Connect Facebook, Instagram, TikTok, YouTube, LinkedIn, X - all in one profile. Share to all socials.</p></div>
<div class="card"><h3 style="margin:0 0 8px">Create Profile - R99/mo - Social Links Included</h3>
<input id="h_name" placeholder="Name / Company Name"><input id="h_title" placeholder="Worktitle / Business Title"><select id="h_type"><option value="individual">Individual - Worktitle</option><option value="company">Company - Business Title</option></select><textarea id="h_bio" placeholder="What do you sell? Price? Location?"></textarea><input id="h_contact" placeholder="WhatsApp 079...">
<div class="grid2"><input id="h_facebook" placeholder="Facebook Link (https://facebook.com/...)"><input id="h_instagram" placeholder="Instagram (https://instagram.com/...)"><input id="h_tiktok" placeholder="TikTok (https://tiktok.com/@...)"><input id="h_youtube" placeholder="YouTube (https://youtube.com/...)"><input id="h_linkedin" placeholder="LinkedIn (https://linkedin.com/...)"><input id="h_x" placeholder="X / Twitter (https://x.com/...)"></div>
<input id="h_payref" placeholder="Payment Ref (Capitec ref)"><button class="btn full" onclick="quickCreate()">Submit for Approval with Socials</button><small>Pay Capitec 0792411584 - All social links will show on marketplace.</small></div></section>
<div class="filters"><input id="searchInput" placeholder="Search plumber, makeup..." oninput="render()"><select id="filterType" onchange="render()"><option value="all">All Types</option><option value="individual">Individuals</option><option value="company">Companies</option></select><select id="filterLoc" onchange="render()"><option value="all">All Locations</option><option value="Mbombela">Mbombela</option><option value="Nelspruit">Nelspruit</option><option value="White River">White River</option></select></div>
<section id="feed" class="feed"></section>
</div>

<div id="dashView" class="hidden">
<div class="dash">
<div class="card"><h2>My Dashboard</h2>
<div id="loginBox"><input id="email" placeholder="Email"><input id="phone" type="password" placeholder="Password (admin: secret)"><button class="btn full" onclick="doLogin()">Login / Register</button></div>
<div id="profileBox" class="hidden"><div id="reminderArea"></div>
<input id="p_name" placeholder="Name"><input id="p_title" placeholder="Worktitle"><select id="p_type"><option value="individual">Individual</option><option value="company">Company</option></select><select id="p_loc"><option>Mbombela</option><option>Nelspruit</option><option>White River</option><option>Hazyview</option></select><textarea id="p_bio" placeholder="Bio"></textarea><input id="p_contact" placeholder="WhatsApp"><input id="p_products" placeholder="Products">
<label style="font-size:12px;font-weight:800;margin-top:10px;display:block">Social Media Links (All Platforms)</label>
<div class="grid2"><input id="p_facebook" placeholder="Facebook"><input id="p_instagram" placeholder="Instagram"><input id="p_tiktok" placeholder="TikTok"><input id="p_youtube" placeholder="YouTube"><input id="p_linkedin" placeholder="LinkedIn"><input id="p_x" placeholder="X / Twitter"></div>
<input id="p_payref" placeholder="Payment Ref"><button class="btn full" onclick="saveProfile()">Submit for Approval / Renewal</button><div id="stats" style="margin-top:12px;background:#fff8db;padding:10px;border-radius:10px;font-size:13px"></div><div id="myProfiles"></div></div></div>
<div class="card"><h3>Orders</h3><div id="orders"></div><h3>Chat</h3><div id="chatBox" style="height:160px;overflow:auto;background:#f5f5f0;padding:8px;border-radius:10px"></div><input id="chatInput" placeholder="Message..."><button class="btn full" onclick="sendChat()">Send</button></div>
</div>
</div>

<div id="adminView" class="hidden">
<div style="max-width:1200px;margin:auto;padding:20px">
<div class="card"><h2>Admin - Approve + Reminders + Socials [SECURED]</h2>
<div style="display:flex;gap:8px;flex-wrap:wrap"><select id="adminFilter" onchange="renderAdmin()"><option value="pending">Pending</option><option value="approved">Approved</option><option value="expiring">Expiring in 5 days</option><option value="expired">Expired</option><option value="rejected">Rejected</option><option value="all">All</option></select><button class="btn light" onclick="renderAdmin()">Refresh</button><button class="btn orange" onclick="sendBulkReminders()">Bulk Remind</button><button class="btn red" onclick="adminLogout()">Lock Admin</button></div><div id="adminList" style="margin-top:14px"></div></div>
</div>
</div>

<footer>ServedYouAre - Social Hub - Founder Stephen Tlou - 0792411584 - All socials connected</footer>
<script>
const DB='sya_v3', USER='sya_user', ORD='sya_orders', CHAT='sya_chat', ADMIN_KEY='sya_admin_auth';
const ADMIN_EMAIL='stephentlou586@gmail.com';
const _0xad = ['0792411584']; const ADMIN_PASS = _0xad[0];
let profiles=JSON.parse(localStorage.getItem(DB)||'[]');
if(!profiles.length){profiles=[{id:'1',name:'Thandi M.',title:'Beauty Therapist',type:'individual',bio:'Mobile nail tech Mbombela R150 set',location:'Mbombela',contact:'0790000001',products:'Gel, R150',views:42,comments:[],owner:'demo',status:'approved',payref:'DEMO-APPROVED',created:'2026-01-01',expiry:Date.now()+1000*60*60*24*25,socials:{facebook:'https://facebook.com',instagram:'https://instagram.com',tiktok:'',youtube:'',linkedin:'',x:''}}];localStorage.setItem(DB,JSON.stringify(profiles));}
function save(){localStorage.setItem(DB,JSON.stringify(profiles));}
function uid(){return Math.random().toString(36).slice(2,8);}
function getUser(){return JSON.parse(localStorage.getItem(USER)||'null');}
function isAdminAuth(){return localStorage.getItem(ADMIN_KEY)==='true';}
function daysLeft(expiry){if(!expiry)return 0;return Math.ceil((expiry-Date.now())/(1000*60*60*24));}
function getSocialsFromForm(prefix){return{facebook:document.getElementById(prefix+'_facebook').value.trim(),instagram:document.getElementById(prefix+'_instagram').value.trim(),tiktok:document.getElementById(prefix+'_tiktok').value.trim(),youtube:document.getElementById(prefix+'_youtube').value.trim(),linkedin:document.getElementById(prefix+'_linkedin').value.trim(),x:document.getElementById(prefix+'_x').value.trim()};}
function socialsHTML(s){if(!s)return '';let h='';if(s.facebook)h+=`<a class="sbtn social" href="${s.facebook}" target="_blank" title="Facebook">📘</a>`;if(s.instagram)h+=`<a class="sbtn social" href="${s.instagram}" target="_blank" title="Instagram">📸</a>`;if(s.tiktok)h+=`<a class="sbtn social" href="${s.tiktok}" target="_blank" title="TikTok">🎵</a>`;if(s.youtube)h+=`<a class="sbtn social" href="${s.youtube}" target="_blank" title="YouTube">▶️</a>`;if(s.linkedin)h+=`<a class="sbtn social" href="${s.linkedin}" target="_blank" title="LinkedIn">💼</a>`;if(s.x)h+=`<a class="sbtn social" href="${s.x}" target="_blank" title="X">𝕏</a>`;return h?`<div class="socialRow">${h}</div>`:'';}
function shareHTML(p){const text=`Check ${p.name} - ${p.title} on ServedYouAre: ${p.bio.substring(0,60)}`;const url=location.href;return `<div class="socialRow"><a class="sbtn" href="https://wa.me/?text=${encodeURIComponent(text+' '+url)}" target="_blank">Share WA</a><a class="sbtn" href="https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}" target="_blank">FB Share</a><a class="sbtn" href="https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(url)}" target="_blank">Share X</a><a class="sbtn" href="${p.socials?.instagram||'https://instagram.com'}" target="_blank">IG</a></div>`;}
function updateUser(){const u=getUser();document.getElementById('userLabel').textContent=u?u.email:'';const isAdmin=u&&u.email.toLowerCase()===ADMIN_EMAIL.toLowerCase()&&isAdminAuth();document.getElementById('tabAdmin').classList.toggle('hidden',!isAdmin);if(u){document.getElementById('loginBox').classList.add('hidden');document.getElementById('profileBox').classList.remove('hidden');const my=profiles.filter(p=>p.owner===u.email);let reminderHTML='';my.forEach(p=>{const d=daysLeft(p.expiry);if(p.status==='approved'&&d<=5&&d>=0)reminderHTML+=`<div class="reminderBanner">⚠️ ${p.name} expires in ${d} days - Renew now!</div>`;if(p.status==='approved'&&d<0)reminderHTML+=`<div class="reminderBanner" style="background:#fee2e2">❌ ${p.name} EXPIRED ${Math.abs(d)} days ago</div>`;if(p.status==='pending')reminderHTML+=`<div class="reminderBanner">⏳ ${p.name} - Pending approval Ref:${p.payref}</div>`;});document.getElementById('reminderArea').innerHTML=reminderHTML||'<div class="reminderBanner" style="background:#dcfce7">✅ No reminders.</div>';document.getElementById('stats').innerHTML='Profiles: '+my.length+' | Views: '+my.reduce((s,p)=>s+p.views,0);document.getElementById('myProfiles').innerHTML=my.map(p=>{const d=daysLeft(p.expiry);return `<div class="comment"><b>${p.name}</b> - ${p.title} <span class="badge ${d<0&&p.status==='approved'?'expired':p.status}">${p.status}</span><br><small>${(p.socials?Object.values(p.socials).filter(v=>v).length:0)} social links | Ref: ${p.payref}</small>${socialsHTML(p.socials)}</div>`}).join('')||'<small>No profiles</small>';}else{document.getElementById('loginBox').classList.remove('hidden');document.getElementById('profileBox').classList.add('hidden');}}
function doLogin(){const e=(document.getElementById('email').value||'').trim();const p=(document.getElementById('phone').value||'').trim();if(!e.includes('@'))return alert('Enter email');if(e.toLowerCase()===ADMIN_EMAIL.toLowerCase()){if(p!==ADMIN_PASS){return alert('Wrong admin password');}localStorage.setItem(ADMIN_KEY,'true');localStorage.setItem(USER,JSON.stringify({email:e}));updateUser();alert('Admin unlocked');showTab('admin');return;}localStorage.setItem(USER,JSON.stringify({email:e}));updateUser();alert('Logged in '+e);showTab('dash');}
function logout(){localStorage.removeItem(USER);localStorage.removeItem(ADMIN_KEY);updateUser();location.reload();}
function adminLogout(){localStorage.removeItem(ADMIN_KEY);document.getElementById('tabAdmin').classList.add('hidden');alert('Admin locked');showTab('market');}
function showTab(t){document.getElementById('marketView').classList.add('hidden');document.getElementById('dashView').classList.add('hidden');document.getElementById('adminView').classList.add('hidden');document.getElementById('tabMarket').classList.remove('active');document.getElementById('tabDash').classList.remove('active');document.getElementById('tabAdmin').classList.remove('active');if(t==='market'){document.getElementById('marketView').classList.remove('hidden');document.getElementById('tabMarket').classList.add('active');render();}else if(t==='dash'){document.getElementById('dashView').classList.remove('hidden');document.getElementById('tabDash').classList.add('active');updateUser();renderOrders();renderChat();}else if(t==='admin'){if(!isAdminAuth()){return alert('Admin password required');}document.getElementById('adminView').classList.remove('hidden');document.getElementById('tabAdmin').classList.add('active');renderAdmin();}}
function makeProfile(name,title,type,bio,contact,payref,loc,products,socials){return{id:uid(),name,title,type,bio,location:loc||'Mbombela',contact,products:products||bio,views:0,comments:[],owner:getUser()?.email||'guest',status:(isAdminAuth()&&getUser()?.email.toLowerCase()===ADMIN_EMAIL.toLowerCase()?'approved':'pending'),payref:payref||'',created:new Date().toLocaleString(),expiry:null,socials:socials||{}};}
function quickCreate(){const name=document.getElementById('h_name').value, title=document.getElementById('h_title').value, type=document.getElementById('h_type').value, bio=document.getElementById('h_bio').value, contact=document.getElementById('h_contact').value, payref=document.getElementById('h_payref').value;if(!name||!title)return alert('Fill name and title');if(!payref)return alert('Enter payment ref');const socials=getSocialsFromForm('h');const p=makeProfile(name,title,type,bio,contact,payref,'Mbombela',bio,socials);profiles.unshift(p);save();render();alert('Submitted with socials - Pending approval');['h_name','h_title','h_bio','h_contact','h_payref','h_facebook','h_instagram','h_tiktok','h_youtube','h_linkedin','h_x'].forEach(id=>{const el=document.getElementById(id);if(el)el.value='';});}
function saveProfile(){const u=getUser();if(!u)return alert('Login first');const name=document.getElementById('p_name').value, title=document.getElementById('p_title').value, type=document.getElementById('p_type').value, bio=document.getElementById('p_bio').value, loc=document.getElementById('p_loc').value, contact=document.getElementById('p_contact').value, products=document.getElementById('p_products').value, payref=document.getElementById('p_payref').value;if(!name||!title)return alert('Fill');if(!payref&&!isAdminAuth())return alert('Enter payment ref');const socials=getSocialsFromForm('p');const p=makeProfile(name,title,type,bio,contact,payref,loc,products,socials);profiles.unshift(p);save();render();updateUser();alert('Submitted with socials!');showTab('dash');}
function render(){const feed=document.getElementById('feed');const q=(document.getElementById('searchInput').value||'').toLowerCase(), t=document.getElementById('filterType').value, l=document.getElementById('filterLoc').value;let list=profiles.filter(p=>{if(p.status!=='approved')return false;if(p.expiry&&daysLeft(p.expiry)<0)return false;return true;}).filter(p=>(!q||(p.name+p.title+p.bio+(p.socials?Object.values(p.socials).join(' '):'')).toLowerCase().includes(q))&&(t==='all'||p.type===t)&&(l==='all'||p.location===l));feed.innerHTML=list.map(p=>{const d=daysLeft(p.expiry);return `<div class="post"><div class="head"><div class="avatar">${p.name[0].toUpperCase()}</div><div><strong>${p.name}</strong><br><small>${p.title} • ${p.type} • ${p.location} • ${d}d left</small></div></div><p style="margin:10px 0 6px">${p.bio}</p><small style="color:#666">Products: ${p.products||''}</small>${socialsHTML(p.socials)}<div class="actions"><button class="sbtn primary" onclick="orderP('${p.id}')">Order</button><button class="sbtn" onclick="commentP('${p.id}')">Comment</button><a class="sbtn" href="https://wa.me/${(p.contact||'').replace(/\D/g,'')}" target="_blank">WhatsApp</a></div>${shareHTML(p)}<div>${(p.comments||[]).map(c=>`<div class="comment"><b>${c.by}:</b> ${c.text}</div>`).join('')}</div></div>`}).join('')||'<p style="padding:20px">No live profiles.</p>';list.forEach(p=>p.views++);save();}
function commentP(id){const txt=prompt('Your comment:');if(!txt)return;const p=profiles.find(x=>x.id===id);p.comments.push({by:getUser()?.email||'Guest',text:txt});save();render();}
function orderP(id){const p=profiles.find(x=>x.id===id);const msg=prompt('What do you order from '+p.name+'?');if(!msg)return;let o=JSON.parse(localStorage.getItem(ORD)||'[]');o.unshift({to:p.name,msg,from:getUser()?.email||'Guest',time:new Date().toLocaleString()});localStorage.setItem(ORD,JSON.stringify(o));alert('Order sent');renderOrders();}
function renderOrders(){const el=document.getElementById('orders');let o=JSON.parse(localStorage.getItem(ORD)||'[]');el.innerHTML=o.slice(0,8).map(x=>`<div class="comment"><b>${x.from}</b> → ${x.to}: ${x.msg}<br><small>${x.time}</small></div>`).join('')||'<small>No orders yet</small>';}
function sendChat(){const i=document.getElementById('chatInput'),t=i.value;if(!t)return;let c=JSON.parse(localStorage.getItem(CHAT)||'[]');c.push({by:getUser()?.email||'Guest',text:t,time:new Date().toLocaleString()});localStorage.setItem(CHAT,JSON.stringify(c));i.value='';renderChat();}
function renderChat(){const el=document.getElementById('chatBox');let c=JSON.parse(localStorage.getItem(CHAT)||'[]');el.innerHTML=c.slice(-10).map(x=>`<div class="comment"><b>${x.by}:</b> ${x.te